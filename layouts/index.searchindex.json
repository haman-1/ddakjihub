{{- /* 검색 색인 — 홈에서 뽑는 /search-index.json (출력 포맷 SearchIndex).
       클라이언트(Fuse.js)가 이 파일을 내려받아 검색한다. 검색 페이지 자신은 제외. */ -}}
{{- /* 콘텐츠 섹션(품종·가이드·일상)의 글만 색인한다 — 소개·검색 같은 유틸리티 페이지 제외 */ -}}
{{- $pages := where site.RegularPages "Section" "in" (slice "breeds" "guides" "daily") }}
[
{{- range $i, $p := $pages }}
{{- if $i }},{{ end }}{"title": {{ $p.Title | jsonify }},"desc": {{ $p.Description | jsonify }},"url": {{ $p.RelPermalink | jsonify }},"section": {{ $p.Section | jsonify }},"breed": {{ $p.Params.breed | default "" | jsonify }},"tags": {{ $p.Params.tags | default slice | jsonify }},"date": {{ $p.Date.Format "2006-01-02" | jsonify }},"content": {{ $p.Plain | jsonify }}}
{{- end }}
]
